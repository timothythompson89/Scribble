<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsScribbleLibrary>true</IsScribbleLibrary>
    <Description>Scribble's element tree: layout (measure/arrange), invalidation, Border, StackPanel, TextBlock, and the host that connects a tree to a window.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Primitives.fs" />
    <Compile Include="InputTypes.fs" />
    <Compile Include="Props.fs" />
    <Compile Include="Icon.fs" />
    <Compile Include="Cursor.fs" />
    <Compile Include="Palette.fs" />
    <Compile Include="Dispatcher.fs" />
    <Compile Include="Scroller.fs" />
    <Compile Include="AppValue.fs" />
    <Compile Include="Cmd.fs" />
    <Compile Include="Animation.fs" />
    <Compile Include="Element.fs" />
    <Compile Include="Style.fs" />
    <Compile Include="Layoutable.fs" />
    <Compile Include="ElementTree.fs" />
    <Compile Include="Input.fs" />
    <Compile Include="Elements/FocusRing.fs" />
    <Compile Include="Elements/Border.fs" />
    <Compile Include="Elements/StackPanel.fs" />
    <Compile Include="Elements/TextBlock.fs" />
    <Compile Include="Elements/IconView.fs" />
    <Compile Include="Elements/Button.fs" />
    <Compile Include="Elements/ScrollViewer.fs" />
    <Compile Include="Elements/ItemsView.fs" />
    <Compile Include="Elements/Grid.fs" />
    <Compile Include="Elements/DockPanel.fs" />
    <Compile Include="Elements/Canvas.fs" />
    <Compile Include="Elements/WrapPanel.fs" />
    <Compile Include="Elements/Separator.fs" />
    <Compile Include="Theme.fs" />
    <Compile Include="Component.fs" />
    <Compile Include="Layer.fs" />
    <Compile Include="ElementHost.fs" />
    <Compile Include="App.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests set element states (pointer over, pressed) directly to draw them. -->
    <InternalsVisibleTo Include="Scribble.Tests" />
    <InternalsVisibleTo Include="Scribble.Tests.Rendering" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Scribble.Platform/Scribble.Platform.fsproj" />
    <ProjectReference Include="../Scribble.Rendering/Scribble.Rendering.fsproj" />
    <ProjectReference Include="../Scribble.Text/Scribble.Text.fsproj" />
  </ItemGroup>
</Project>

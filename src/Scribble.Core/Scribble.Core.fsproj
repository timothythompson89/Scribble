<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsScribbleLibrary>true</IsScribbleLibrary>
    <Description>Scribble's core: views and the differ, elements, layout, styles and themes, input, components, the element types (panels, scrolling, controls), and the host that connects element trees to a window.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Foundation/Primitives.fs" />
    <Compile Include="Foundation/InputTypes.fs" />
    <Compile Include="Foundation/Props.fs" />
    <Compile Include="Foundation/Icon.fs" />
    <Compile Include="Foundation/Image.fs" />
    <Compile Include="Foundation/ImageCache.fs" />
    <Compile Include="Foundation/Cursor.fs" />
    <Compile Include="Foundation/Palette.fs" />
    <Compile Include="Foundation/Dispatcher.fs" />
    <Compile Include="Foundation/Scroller.fs" />
    <Compile Include="Foundation/AppValue.fs" />
    <Compile Include="Foundation/RenderServices.fs" />
    <Compile Include="Foundation/Cmd.fs" />
    <Compile Include="Foundation/Animation.fs" />
    <Compile Include="Framework/Element.fs" />
    <Compile Include="Framework/Capture.fs" />
    <Compile Include="Framework/Flyout.fs" />
    <Compile Include="Framework/Style.fs" />
    <Compile Include="Framework/Layoutable.fs" />
    <Compile Include="Framework/Semantics.fs" />
    <Compile Include="Framework/ElementTree.fs" />
    <Compile Include="Framework/Input.fs" />
    <Compile Include="Elements/Basic/FocusRing.fs" />
    <Compile Include="Elements/Basic/Border.fs" />
    <Compile Include="Elements/Basic/Flyout.fs" />
    <Compile Include="Elements/Basic/TextBlock.fs" />
    <Compile Include="Elements/Basic/IconView.fs" />
    <Compile Include="Elements/Basic/ImageView.fs" />
    <Compile Include="Elements/Basic/Separator.fs" />
    <Compile Include="Elements/Panels/StackPanel.fs" />
    <Compile Include="Elements/Panels/Grid.fs" />
    <Compile Include="Elements/Panels/DockPanel.fs" />
    <Compile Include="Elements/Panels/Canvas.fs" />
    <Compile Include="Elements/Panels/WrapPanel.fs" />
    <Compile Include="Elements/Scrolling/ScrollViewer.fs" />
    <Compile Include="Elements/Scrolling/ItemsLayout.fs" />
    <Compile Include="Elements/Scrolling/KeyStore.fs" />
    <Compile Include="Elements/Scrolling/ItemsView.fs" />
    <Compile Include="Elements/Controls/Control.fs" />
    <Compile Include="Elements/Controls/Button.fs" />
    <Compile Include="Elements/Controls/ToggleButton.fs" />
    <Compile Include="Elements/Controls/CheckBox.fs" />
    <Compile Include="Elements/Controls/Switch.fs" />
    <Compile Include="Elements/Controls/Slider.fs" />
    <Compile Include="Elements/Controls/TabControl.fs" />
    <Compile Include="Elements/Controls/ListBox.fs" />
    <Compile Include="Elements/Controls/RadioButton.fs" />
    <Compile Include="Elements/Controls/ComboBox.fs" />
    <Compile Include="Elements/Controls/Modal.fs" />
    <Compile Include="Elements/Controls/Toast.fs" />
    <Compile Include="Themes/Theme.fs" />
    <Compile Include="Hosting/Toaster.fs" />
    <Compile Include="Hosting/Dialogs.fs" />
    <Compile Include="Hosting/Component.fs" />
    <Compile Include="Hosting/Layer.fs" />
    <Compile Include="Hosting/ElementHost.fs" />
    <Compile Include="Hosting/SemanticTree.fs" />
    <Compile Include="Hosting/App.fs" />
    <Compile Include="Hosting/ViewImage.fs" />
    <Compile Include="Hosting/Files.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tests set element states (pointer over, pressed) directly to draw them. -->
    <InternalsVisibleTo Include="Scribble.Tests" />
    <InternalsVisibleTo Include="Scribble.Tests.Rendering" />
    <InternalsVisibleTo Include="Scribble.Bench" />
    <!-- The page's address for relative image URLs (ImageHttp.BaseUrl). -->
    <InternalsVisibleTo Include="Scribble.Browser" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Scribble.Platform/Scribble.Platform.fsproj" />
    <ProjectReference Include="../Scribble.Rendering/Scribble.Rendering.fsproj" />
    <ProjectReference Include="../Scribble.Text/Scribble.Text.fsproj" />
  </ItemGroup>
</Project>

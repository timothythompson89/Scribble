<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsScribbleLibrary>true</IsScribbleLibrary>
    <Description>Google's Material Symbols for Scribble: every icon as an Icon value (Material.home), outlined and filled. Icons: © Google, Apache License 2.0.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="MaterialData.fs" />
    <!-- Generated by tools/GenerateMaterial.fsx. -->
    <Compile Include="Material.fs" />
    <Compile Include="MaterialExtensions.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Material Symbols (Outlined style, weight 400) as "name<TAB>path" lines, uncompressed (~5 MB together): the
         browser's .NET has no Brotli decoder, and a browser publish Brotli-compresses the DLL (~0.8 MB download). -->
    <EmbeddedResource Include="Data/outlined.txt" LogicalName="Scribble.Icons.Material.outlined.txt" />
    <EmbeddedResource Include="Data/filled.txt" LogicalName="Scribble.Icons.Material.filled.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Scribble.Core/Scribble.Core.fsproj" />
  </ItemGroup>
</Project>

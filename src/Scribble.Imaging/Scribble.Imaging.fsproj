<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsScribbleLibrary>true</IsScribbleLibrary>
    <Description>Image decoding and encoding for Scribble: bytes in, premultiplied RGBA out; straight RGBA in, PNG out. Our own PNG decoder and encoder (no GPU, no elements).</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Pixels.fs" />
    <Compile Include="Rows.fs" />
    <Compile Include="Crc32.fs" />
    <Compile Include="Png.fs" />
    <Compile Include="ImageDecoder.fs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Scribble.Tests" />
    <InternalsVisibleTo Include="Scribble.Bench" />
  </ItemGroup>
</Project>

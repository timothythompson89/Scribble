<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- IL2104/IL3053 are one-line summaries saying a *referenced* assembly (FSharp.Core) has trim/AOT
         warnings of its own. We can't fix those, and we avoid the affected features (printf, %A), so they
         stay visible as warnings without failing the build. AOT warnings in Scribble's code still fail it. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <!-- 9 = unverifiable IL (native pointers), 51 = address-of (&&). Expected in interop code. -->
    <NoWarn>$(NoWarn);FS0009;FS0051</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Scribble contributors</Authors>
    <Product>Scribble</Product>
    <Copyright>Copyright (c) 2026 Timothy Thompson</Copyright>
    <!-- One version for every package (DESIGN.md, "Publishing", decision 8). The release workflow passes
         -p:Version from the tag; this is what a local pack gets. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>fsharp;ui;gui;webgpu;wasm;nativeaot;funcui</PackageTags>
    <!-- Stepping into Scribble from an app: the repository's address and commit go into the package (SourceLink is
         part of the SDK), and the PDBs into a .snupkg beside it. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <!-- Only English resources (skips FSharp.Core's translated-message folders in the output). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- What depends on a project's own IsScribbleLibrary is in Directory.Build.targets: this file is read before
       the project sets it. -->
</Project>

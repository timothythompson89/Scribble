<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Measures ItemsView's recycling (where a scroll step's time goes). A development tool: not part
    of Scribble, never shipped. Run it in Release:
      dotnet run -c Release (in tools/Scribble.Bench)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Scribble.Core/Scribble.Core.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text.HarfBuzz/Scribble.Text.HarfBuzz.fsproj" />
  </ItemGroup>
</Project>

// Generates the Scribble.Icons.Material package's data and its Material.fs:
//
//   dotnet fsi tools/GenerateMaterial.fsx <path to MaterialIconData.cs>
//
// The source is the generated MaterialIconData.cs from Tim's CustomAvaloniaControls (Google's
// Material Symbols, Outlined style, FILL 0 and FILL 1 at wght 400, GRAD 0, opsz 24, as
// Brotli-compressed "name<TAB>path data" lines, base64 encoded). It writes:
//
//   src/Scribble.Icons.Material/Data/outlined.txt, filled.txt  the decoded "name<TAB>path" lines (stored as
//                                                               text: the browser's .NET has no Brotli decoder,
//                                                               and a browser publish compresses the DLL anyway)
//   src/Scribble.Icons.Material/Material.fs                   a member per icon, and the functions
//
// Material Symbols are © Google, licensed under the Apache License 2.0.

open System
open System.IO
open System.IO.Compression
open System.Text
open System.Text.RegularExpressions

let source =
    match fsi.CommandLineArgs |> Array.tryItem 1 with
    | Some p -> p
    | None -> @"C:\Users\Timot\Source\dotnet\CustomAvaloniaControls\CustomAvaloniaControls\Icons\MaterialIconData.cs"

let repo = Path.GetFullPath(Path.Combine(__SOURCE_DIRECTORY__, ".."))
let project = Path.Combine(repo, "src", "Scribble.Icons.Material")

let blocks =
    Regex.Matches(File.ReadAllText source, "const string (\\w+)Data = @\"([^\"]*)\"")
    |> Seq.map (fun m -> m.Groups[1].Value.ToLowerInvariant(), Convert.FromBase64String m.Groups[2].Value)
    |> Map.ofSeq

let decode (bytes: byte[]) =
    use brotli = new BrotliStream(new MemoryStream(bytes), CompressionMode.Decompress)
    use reader = new StreamReader(brotli, Encoding.UTF8)
    [ for line in reader.ReadToEnd().Split('\n', StringSplitOptions.RemoveEmptyEntries) do
        let tab = line.IndexOf '\t'
        line.Substring(0, tab), line.Substring(tab + 1) ]

let outlined, filled = decode blocks["outlined"], decode blocks["filled"]
let names = outlined |> List.map fst
if names <> (filled |> List.map fst) then failwith "The outlined and filled sets name different icons."
for n in names do
    if not (Regex.IsMatch(n, "^[a-z0-9_]+$")) then failwith ("Unexpected icon name: " + n)

Directory.CreateDirectory(Path.Combine(project, "Data")) |> ignore
for variant in [ "outlined"; "filled" ] do
    let lines = if variant = "outlined" then outlined else filled
    let text = String.Join("", lines |> List.map (fun (n, d) -> n + "\t" + d + "\n"))
    File.WriteAllText(Path.Combine(project, "Data", variant + ".txt"), text, UTF8Encoding false)
    let old = Path.Combine(project, "Data", variant + ".br")
    if File.Exists old then File.Delete old

// arrow_upward -> arrowUpward; 10k -> _10k; F# keywords in double backticks.
let keywords = set [ "class"; "done"; "event"; "function"; "public"; "select"; "try"; "type"; "open"; "default"; "base" ]
let memberName (name: string) =
    let parts = name.Split '_'
    let camel =
        parts[0] + String.Join("", parts[1..] |> Array.map (fun p -> if p = "" then "" else string (Char.ToUpperInvariant p[0]) + p.Substring 1))
    let camel = if Char.IsDigit camel[0] then "_" + camel else camel
    if keywords.Contains camel then "``" + camel + "``" else camel

let members = names |> List.map memberName
if (List.distinct members).Length <> members.Length then failwith "Two icons get the same member name."

let code = StringBuilder()
let line (s: string) = code.Append(s).Append('\n') |> ignore
line "// GENERATED by tools/GenerateMaterial.fsx from Google's Material Symbols; don't edit by hand."
line "//"
line "// Material Symbols are © Google, licensed under the Apache License 2.0"
line "// (https://www.apache.org/licenses/LICENSE-2.0)."
line "namespace Scribble.Icons"
line ""
line "open Scribble.Core"
line ""
line "/// Google's Material Symbols (Outlined style, weight 400): every icon by name, in camelCase"
line "/// (`Material.home`, `Material.arrowUpward`; a leading digit gets `_`: `Material._10k`; F# keywords"
line "/// in double backticks: ``Material.``class`` ``). Each is an `Icon` value in Google's 960 × 960 box."
line "/// `Material.home.filled` (or `Material.filled`) gives the filled version; `Material.icon \"star-filled-rotate90\"` reads names"
line "/// from text. Names: https://fonts.google.com/icons. © Google, Apache License 2.0."
line "[<AbstractClass; Sealed>]"
line "type Material ="
for name, m in List.zip names members do
    line ("    static member " + m + " = MaterialData.named \"" + name + "\"")
line ""
line "/// What works on any Material icon (the module beside the `Material` type, as for elements)."
line "module Material ="
line "    /// The filled version (rotation and flips kept). About a third of the icons look the same either"
line "    /// way. An icon that isn't a Material icon comes back unchanged."
line "    let filled (icon: Icon) : Icon = MaterialData.variant true icon"
line "    /// The outlined version (the default), rotation and flips kept."
line "    let outlined (icon: Icon) : Icon = MaterialData.variant false icon"
line "    /// An icon from text: a name and options read from the end, separated by '-': filled,"
line "    /// outlined, rotate<degrees>, fliph, flipv (\"star-filled-rotate90\", \"arrow-upward-fliph\";"
line "    /// '-' or ' ' in the name means '_'). `Icon.describe` gives text this reads back. Throws an"
line "    /// ArgumentException for a name that isn't a Material icon."
line "    let icon (text: string) : Icon = MaterialData.fromText text"
line "    /// Like `Material.icon`, but ValueNone for a name that isn't a Material icon."
line "    let tryIcon (text: string) : Icon voption = MaterialData.tryFromText text"
line "    /// Every icon's name (Google's: lowercase with underscores), in order."
line "    let names () : string seq = MaterialData.names ()"
File.WriteAllText(Path.Combine(project, "Material.fs"), code.ToString())
Console.WriteLine(string names.Length + " icons")

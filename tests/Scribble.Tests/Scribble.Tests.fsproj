<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Destructuring a voption in a test is fine: a mismatch is a test failure anyway. -->
    <NoWarn>$(NoWarn);FS0025</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FrameClockTests.fs" />
    <Compile Include="ColorTests.fs" />
    <Compile Include="DrawListTests.fs" />
    <Compile Include="TestShaping.fs" />
    <Compile Include="TextTests.fs" />
    <Compile Include="TextLayoutTests.fs" />
    <Compile Include="IconTests.fs" />
    <Compile Include="LayoutTests.fs" />
    <Compile Include="LengthTests.fs" />
    <Compile Include="DifferTests.fs" />
    <Compile Include="AppTests.fs" />
    <Compile Include="InputTests.fs" />
    <Compile Include="KeyboardTests.fs" />
    <Compile Include="ComponentTests.fs" />
    <Compile Include="AsyncTests.fs" />
    <Compile Include="../../samples/Shared/Counter/Common.fs" Link="Common.fs" />
    <Compile Include="../../samples/Shared/Counter/ElmishTab.fs" Link="ElmishTab.fs" />
    <Compile Include="../../samples/Shared/Counter/LoadTab.fs" Link="LoadTab.fs" />
    <Compile Include="../../samples/Shared/Counter/ListTab.fs" Link="ListTab.fs" />
    <Compile Include="../../samples/Shared/Counter/LayersTab.fs" Link="LayersTab.fs" />
    <Compile Include="../../samples/Shared/Counter/StylesTab.fs" Link="StylesTab.fs" />
    <Compile Include="../../samples/Shared/Counter/Counter.fs" Link="Counter.fs" />
    <Compile Include="TabsTests.fs" />
    <Compile Include="StyleTests.fs" />
    <Compile Include="ThemeTests.fs" />
    <Compile Include="TokenTests.fs" />
    <Compile Include="AppValueTests.fs" />
    <Compile Include="LayerTests.fs" />
    <Compile Include="InspectorTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Scribble.Core/Scribble.Core.fsproj" />
    <ProjectReference Include="../../src/Scribble.Inspector/Scribble.Inspector.fsproj" />
    <ProjectReference Include="../../src/Scribble.Platform/Scribble.Platform.fsproj" />
    <ProjectReference Include="../../src/Scribble.Rendering/Scribble.Rendering.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text/Scribble.Text.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text.Emoji/Scribble.Text.Emoji.fsproj" />
  </ItemGroup>
</Project>

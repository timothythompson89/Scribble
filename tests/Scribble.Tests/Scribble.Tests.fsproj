<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Destructuring a voption in a test is fine: a mismatch is a test failure anyway. -->
    <NoWarn>$(NoWarn);FS0025</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Timing.fs" />
    <Compile Include="FrameClockTests.fs" />
    <Compile Include="ColorTests.fs" />
    <Compile Include="DrawListTests.fs" />
    <Compile Include="TestShaping.fs" />
    <Compile Include="TextTests.fs" />
    <Compile Include="TextLayoutTests.fs" />
    <Compile Include="IconTests.fs" />
    <Compile Include="LayoutTests.fs" />
    <Compile Include="LengthTests.fs" />
    <Compile Include="DifferTests.fs" />
    <Compile Include="AppTests.fs" />
    <Compile Include="FilesTests.fs" />
    <Compile Include="ErrorTests.fs" />
    <Compile Include="InputTests.fs" />
    <Compile Include="KeyboardTests.fs" />
    <Compile Include="ComponentTests.fs" />
    <Compile Include="AsyncTests.fs" />
    <Compile Include="MaterialTests.fs" />
    <Compile Include="GalleryPagesTests.fs" />
    <Compile Include="StyleTests.fs" />
    <Compile Include="ThemeTests.fs" />
    <Compile Include="ThemeValueTests.fs" />
    <Compile Include="AppValueTests.fs" />
    <Compile Include="LayerTests.fs" />
    <Compile Include="ItemsViewTests.fs" />
    <Compile Include="PanelTests.fs" />
    <Compile Include="VirtualizationTests.fs" />
    <Compile Include="InspectorTests.fs" />
    <Compile Include="IdleTests.fs" />
    <Compile Include="ControlsTests.fs" />
    <Compile Include="ListBoxTests.fs" />
    <Compile Include="RadioButtonTests.fs" />
    <Compile Include="ComboBoxTests.fs" />
    <Compile Include="TextBoxTests.fs" />
    <Compile Include="ModalTests.fs" />
    <Compile Include="ToastTests.fs" />
    <Compile Include="DialogsTests.fs" />
    <Compile Include="SemanticsTests.fs" />
    <Compile Include="PngTests.fs" />
    <Compile Include="ImageAtlasTests.fs" />
    <Compile Include="ImageViewTests.fs" />
    <Compile Include="ImageLoadingTests.fs" />
    <Compile Include="ImageCursorTests.fs" />
    <Compile Include="FlyoutTests.fs" />
    <Compile Include="ImageRobustnessTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- PngSuite (Willem van Schaik, free to use: PngSuite/PngSuite.LICENSE) and the WIC references made by
         tools/MakePngReferences.fsx. -->
    <None Include="PngSuite/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Scribble.Core/Scribble.Core.fsproj" />
    <ProjectReference Include="../../src/Scribble.Imaging/Scribble.Imaging.fsproj" />
    <ProjectReference Include="../../samples/Gallery/Gallery.fsproj" />
    <ProjectReference Include="../../samples/Hello/Hello.fsproj" />
    <ProjectReference Include="../../samples/Icons/Icons.fsproj" />
    <ProjectReference Include="../../src/Scribble.Inspector/Scribble.Inspector.fsproj" />
    <ProjectReference Include="../../src/Scribble.Icons.Material/Scribble.Icons.Material.fsproj" />
    <ProjectReference Include="../../src/Scribble.Platform/Scribble.Platform.fsproj" />
    <ProjectReference Include="../../src/Scribble.Rendering/Scribble.Rendering.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text/Scribble.Text.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text.Emoji/Scribble.Text.Emoji.fsproj" />
  </ItemGroup>
</Project>

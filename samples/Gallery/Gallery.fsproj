<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Include="Common.fs" />
    <Compile Include="ComponentsPage.fs" />
    <Compile Include="LayoutPage.fs" />
    <Compile Include="ControlsPage.fs" />
    <Compile Include="ScrollingPage.fs" />
    <Compile Include="ListsPage.fs" />
    <Compile Include="LayersPage.fs" />
    <Compile Include="StylesPage.fs" />
    <Compile Include="ImagesPage.fs" />
    <Compile Include="GalleryApp.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Drawn by tools/MakeGalleryImages.fsx; Image.fromResource names them by file name. -->
    <EmbeddedResource Include="Images/*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Scribble.Core/Scribble.Core.fsproj" />
    <ProjectReference Include="../Samples.Shared/Samples.Shared.fsproj" />
    <ProjectReference Include="../../src/Scribble.Icons.Material/Scribble.Icons.Material.fsproj" />
    <ProjectReference Include="../../src/Scribble.Text.Emoji/Scribble.Text.Emoji.fsproj" />
  </ItemGroup>
</Project>
